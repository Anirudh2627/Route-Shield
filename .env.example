# ============================================================
# RouteShield environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

# --- General ---
ENVIRONMENT=development
# SQLite for the MVP; swap for PostgreSQL without code changes, e.g.
# DATABASE_URL=postgresql+psycopg://routeshield:secret@db:5432/routeshield
# DATABASE_URL=sqlite:////data/routeshield.db
DATABASE_URL=

# --- Manager account (authentication) ---
# Set a strong password for any public deployment. If left empty, a random
# password is generated at startup and printed ONCE in the backend logs.
ROUTESHIELD_MANAGER_USERNAME=fleet.manager
ROUTESHIELD_MANAGER_PASSWORD=
# HMAC signing key for session tokens. REQUIRED in production (otherwise
# tokens are invalidated on every restart).
ROUTESHIELD_AUTH_SECRET=

# --- NHTSA integration (official public APIs) ---
NHTSA_API_BASE=https://api.nhtsa.gov
NHTSA_STATIC_BASE=https://static.nhtsa.gov
VPIC_API_BASE=https://vpic.nhtsa.dot.gov
HTTP_TIMEOUT_SECONDS=30
# Minimum spacing between outbound vPIC requests (rate-limit respect).
VPIC_MIN_REQUEST_INTERVAL_SECONDS=2
# Fall back to the manually reviewed fixture when live retrieval fails.
ALLOW_OFFLINE_FALLBACK=true
# Attempt a live NHTSA refresh in the background at startup.
AUTO_REFRESH_RECALL=true

# --- Vultr Serverless Inference (LLM) ---
# Two read-only uses: (1) structured report extraction (marked NEEDS_REVIEW);
# (2) the bounded Incident Response Agent (Agent Console). The LLM never
# writes operational records and never classifies vehicles.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=

# --- Incident Response Agent (Agent Console) ---
# Hard-bounded, read-only tool-calling loop. The model may only call tools
# from services/agent_tools.py (evidence, assessments, impact previews,
# spares, verification items, vehicle detail, audit trail). Max 8 rounds.
AGENT_MAX_ITERATIONS=8
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_TOTAL_BUDGET_SECONDS=300

# --- Frontend / CORS ---
# Comma-separated list of browser origins allowed to call the API directly.
# Leave EMPTY in production when the frontend is served same-origin behind the
# nginx proxy (the default compose setup): empty = no cross-origin access.
# For local development with the Vite dev server:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: serve the built frontend from the backend process.
SERVE_FRONTEND_DIR=
